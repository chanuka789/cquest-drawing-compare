# Copy this file to .env and fill in what you need.
# .env is never committed.

# 1 = development mode (UI loads from the Vite dev server at localhost:5173)
# 0 or unset = production mode (UI loads from the built files in ui/dist)
CQDC_DEV=1

# Log level: DEBUG, INFO, WARNING, ERROR
CQDC_LOG_LEVEL=DEBUG

# Overrides where the application keeps its data, which is normally
# %LOCALAPPDATA%\CQuest\DrawingCompare. The test suite sets this so tests
# never write into your real database, logs or cache.
# CQDC_APP_DATA=

# Optional. Not needed until Phase 7 (AI layer). Leave empty for offline mode.
ANTHROPIC_API_KEY=
